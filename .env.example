# LOCAL development only. Copy to .env; never put cloud credentials in Git.
MINIO_ROOT_USER=citypass-local
MINIO_ROOT_PASSWORD=citypass-local-change-me
OBJECT_STORAGE_PROVIDER=minio
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=citypass-story-files
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=citypass-local
OBJECT_STORAGE_SECRET_KEY=citypass-local-change-me
STORY_CORS_ORIGINS=http://localhost:8080,http://localhost:8081
STORY_DEBUG_PAGE_ENABLED=true
# TTLs and grace periods in seconds; smaller values are for isolated verification only.
STORY_FILE_UPLOAD_SECONDS=300
STORY_FILE_READ_SECONDS=120
STORY_FILE_CLEANUP_GRACE_SECONDS=120
STORY_FILE_TOMBSTONE_RESCAN_SECONDS=3600
STORY_FILE_MAX_BYTES=10485760
STORY_FILE_MAX_PIXELS=20000000
STORY_FILE_MAX_DIMENSION=10000
STORY_FILE_MAX_IMAGES=9
STORY_FILE_PENDING_QUOTA=20
STORY_FILE_DRAFT_HOURS=24
STORY_FILE_CONFIRMATION_LEASE_SECONDS=60
STORY_FILE_IO_CONCURRENCY=4
# Set all ports and public endpoint together if another stack uses these ports.
MYSQL_HOST_PORT=3307
REDIS_HOST_PORT=6379
NAMESRV_HOST_PORT=9876
BROKER_FAST_HOST_PORT=10909
BROKER_HOST_PORT=10911
APP_HOST_PORT=8081
GATEWAY_HOST_PORT=8080
MINIO_HOST_PORT=9000
MINIO_CONSOLE_PORT=9001
